<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- roues motrices qui accrochent, roues folles qui glissent -->
  <gazebo reference="roue_gauche"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="roue_droite"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="folle_av_g"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="folle_av_d"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="folle_ar_g"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="folle_ar_d"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <!-- entrainement differentiel : ecoute /cmd_vel, publie /odom -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>roue_gauche_joint</left_joint>
      <right_joint>roue_droite_joint</right_joint>
      <wheel_separation>${voie}</wheel_separation>
      <wheel_diameter>${2*roue_r}</wheel_diameter>
      <max_wheel_torque>50</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- rplidar s2 : 360 degres, 30 m, 10 hz -->
  <gazebo reference="lidar">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar</frame_name>
      </plugin>
    </sensor>
  </gazebo>

    <!-- mat commande par ros2_control -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="mat_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="mat_2_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find robot_inventaire_description)/config/controleurs.yaml</parameters>
    </plugin>
  </gazebo>

    <!-- cameras actives : aucune, test ou toutes -->
  <xacro:arg name="cameras" default="test"/>
  <xacro:property name="mode_cam" value="$(arg cameras)"/>

  <xacro:macro name="camera_gazebo" params="nom">
    <xacro:if value="${mode_cam == 'toutes' or (mode_cam == 'test' and nom in ['cam_g_1', 'cam_g_4'])}">
      <gazebo reference="${nom}">
        <sensor name="${nom}" type="camera">
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <visualize>false</visualize>
          <camera>
            <!-- gemini 335 : 86 degres, 1920 x 1080 -->
            <horizontal_fov>1.501</horizontal_fov>
            <image>
              <width>1920</width>
              <height>1080</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>10.0</far></clip>
            <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
          </camera>
          <plugin name="${nom}_plugin" filename="libgazebo_ros_camera.so">
            <camera_name>${nom}</camera_name>
            <frame_name>${nom}_optique</frame_name>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>

  <xacro:camera_gazebo nom="cam_g_1"/>
  <xacro:camera_gazebo nom="cam_g_2"/>
  <xacro:camera_gazebo nom="cam_g_3"/>
  <xacro:camera_gazebo nom="cam_g_4"/>
  <xacro:camera_gazebo nom="cam_g_5"/>
  <xacro:camera_gazebo nom="cam_d_1"/>
  <xacro:camera_gazebo nom="cam_d_2"/>
  <xacro:camera_gazebo nom="cam_d_3"/>
  <xacro:camera_gazebo nom="cam_d_4"/>
  <xacro:camera_gazebo nom="cam_d_5"/>
  <xacro:camera_gazebo nom="cam_avant"/>

</robot>